# Copy to /etc/sippymodem/default.env, restrict to root, then edit.
# Direct SIP endpoint; replace the identity with your own before use.
SIP_REGISTER=0
SIP_ID=sip:modem@example.invalid
SIP_PORT=5060
SIP_RTP_PORT=40000
SIP_CODEC=PCMU
SIP_REMOTE_CLOCK=1
SIP_AUTO_ANSWER=0
SIP_TRACE=0
MODEM_LOG_TARGET=stderr

# For a registered provider, replace the direct identity above as needed:
# SIP_REGISTER=1
# SIP_LOGIN=account:password@registrar.example.invalid:5060
# SIP_TARGET=sip:modem@peer.example.invalid
# Set SIP_PUBLIC_ADDR only for an already configured NAT route.
# Use different SIP_PORT and SIP_RTP_PORT values for each service instance.
